# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Render provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/evida

# JWT — use a long random string (32+ characters)
JWT_SECRET=replace-this-with-a-long-random-secret

# Rook webhook signature secret (from Rook developer dashboard)
ROOK_WEBHOOK_SECRET=your-rook-hmac-secret

# Email (nodemailer) — use Gmail app password or Resend SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Expo push notifications are handled automatically via expo-server-sdk.
# No credentials needed here — users register their Expo push token
# via PATCH /auth/me with { expo_push_token: "ExponentPushToken[...]" }
