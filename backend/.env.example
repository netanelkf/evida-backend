# eVida live backend — environment variables
# Copy to .env (or set these in your hosting platform) before running outside Replit.

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@host:5432/evida

# --- Server ---
PORT=3001
# production | development — controls webhook signature enforcement and demo-user seeding
NODE_ENV=development

# --- ROOK (universal wearable data layer) ---
ROOK_CLIENT_UUID=
ROOK_CLIENT_SECRET=

# --- Direct Fitbit OAuth (kept for backward compatibility alongside ROOK) ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3001

# --- Twilio (real SMS / WhatsApp / voice-call alerts) ---
# Create a free trial account at twilio.com to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A phone number you bought/rented in Twilio, E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# --- WhatsApp (primary alert channel for Panama — see twilio.com/docs/whatsapp) ---
# The WhatsApp-enabled sender number, set up via Twilio's WhatsApp Self
# Sign-up (creates/links a Meta WhatsApp Business Account). Meta's business
# verification for this can take from a few days up to several weeks —
# start it early, it's the long pole here, not the code.
TWILIO_WHATSAPP_FROM=
# SID (starts with HX...) of an approved Content Template in Twilio Console
# > Content Template Builder. Required for eVida to message someone who
# hasn't messaged in first — plain text only works as a reply within a 24h
# window, which never applies to an unprompted emergency alert. Template
# approval is fast (5 min-24h) once the sender itself is approved.
TWILIO_WHATSAPP_CONTENT_SID=

# --- Other device brand OAuth apps (not wired into any route yet) ---
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
SAMSUNG_CLIENT_ID=
SAMSUNG_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
